<script>
	document.addEventListener("DOMContentLoaded", function () {
	var anchors = document.querySelectorAll('a[href^="#"]');
	for (var i = 0; i < anchors.length; i++) {
		anchors[i].addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
		e.preventDefault();
		const target = document.querySelector(this.getAttribute('href')!); // Añadir el signo de no-null para aclarar el tipo
		if (target) {
			target.scrollIntoView({
			behavior: 'smooth'
			});
		}
		});
	}
	});
</script>

