---
// import mcm from '../assets/MCM-2.webp'
import mcm from '../assets/Mapa.png'
---

<div class="sticky-btn absolute hidden md:block top-20 right-0 w-12 h-12 z-40">
    <a href="https://micasamx.com/" target="_blank" class="sticky-btn sticky-btn--micasa z-50">
        <img src={mcm.src} loading="lazy" alt="fachada" class="w-full h-full">
    </a>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Mostrar el modal si existe
        const popup = document.getElementById("popup");
        if (popup) {
            popup.style.display = "block"; // O ajusta según tus necesidades
        }

        // Seleccionar el contenedor principal con la clase "sticky-btn"
        const stickyBtnContainers = document.querySelectorAll(".sticky-btn");
        stickyBtnContainers.forEach(container => {
            // Aseguramos que container es un HTMLElement antes de acceder a 'style'
            const htmlElement = container as HTMLElement;
            htmlElement.style.transform = "translateX(-10px)";
            htmlElement.style.transitionDuration = "3s";
            htmlElement.style.position = "absolute";
        });

        // Detectar dispositivos móviles y ajustar el ancho del contenedor principal
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        if (isMobile) {
            stickyBtnContainers.forEach(container => {
                const htmlElement = container as HTMLElement;
                htmlElement.style.width = "150px";
            });
        }
    });
</script>